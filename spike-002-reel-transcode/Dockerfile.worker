# Descartavel - so para o spike PHF-002 medir CPU/memoria sob limite real de container.
# Nao e o Dockerfile de producao (esse fica em ../Dockerfile, app Next.js).
FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY worker.js transcode.js ./
CMD ["node", "worker.js"]
